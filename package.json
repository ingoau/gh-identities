{
  "name": "@ingowolf/gh-identities",
  "version": "1.0.0",
  "description": "List the names and emails used to commit across all of a GitHub user's repos",
  "type": "module",
  "bin": {
    "gh-identities": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/cli.jsx --bundle --packages=external --platform=node --format=esm --target=node22 --jsx=automatic --outfile=dist/cli.js",
    "start": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "github",
    "git",
    "email",
    "commits",
    "authors",
    "cli"
  ],
  "author": "Ingo Wolf",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingoau/gh-identities.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
